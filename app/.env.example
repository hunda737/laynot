# Telegram Mini App links. Copy to .env.local and fill in, then rebuild the web export.
# From BotFather: the bot's username (without @) and the Mini App's short name,
# so links look like https://t.me/<EXPO_PUBLIC_TG_BOT>/<EXPO_PUBLIC_TG_APP>?startapp=...
# Without them, duel and league links fall back to the normal web link.
EXPO_PUBLIC_TG_BOT=laynot_bot
EXPO_PUBLIC_TG_APP=play
