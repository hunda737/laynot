# Copy to .env and fill in. Never commit .env: it holds the bot token.

# From @BotFather when you created the bot.
BOT_TOKEN=

# The public https address of THIS server (the ngrok address while testing).
# The Mini App and the Play buttons open it.
WEBAPP_URL=https://your-name.ngrok-free.app

# Short name of the Mini App from BotFather /newapp (gives t.me/<bot>/<short name>).
# Used for links in channel posts.
MINIAPP_SHORT_NAME=myapp

# Telegram user IDs allowed to use /broadcast, /stats and /channel, comma separated.
# Send /id to the bot to find yours.
ADMIN_IDS=

# Optional: a channel for the daily post and /channel. @channelname or -100...
# Add the bot to the channel as an administrator first.
CHANNEL_ID=

# Optional
PORT=3000
# Time zone for reminders until a player's phone reports its own, in minutes east of UTC. Ethiopia is 180.
DEFAULT_TZ_OFFSET=180
# Where the built Mini App is. Default: ../app/dist
# DIST_DIR=
# Where the database file lives. Default: server/data/laynot.db
# DB_PATH=
